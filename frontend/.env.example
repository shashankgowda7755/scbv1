# Optional: expose webpack health endpoints during local development.
ENABLE_HEALTH_CHECK=false

# Firebase web app configuration.
# When ALL four required values (apiKey, authDomain, projectId, appId) are set,
# the app writes events + registrations to Cloud Firestore. If omitted, the app
# falls back to localStorage demo mode.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Field-level encryption key (AES-256-GCM).
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Same value must be set everywhere the demo runs so all operators can decrypt.
# If omitted, each browser generates a random key into localStorage — fine for
# local demo, bad for production (operators on other devices can't decrypt).
REACT_APP_DATA_KEY=

# Operator passphrase gate.
# The dashboard + create-event UI is hidden behind this passphrase. Participant
# (?mode=register) view is always public so the QR works. Leave empty to skip
# the gate (NOT recommended in production).
REACT_APP_OPERATOR_PASSPHRASE=
