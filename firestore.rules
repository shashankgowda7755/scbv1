rules_version = '2';

// Security rules for the SCB Event Registration platform.
//
// Trust model:
//   - The browser AES-256-GCM encrypts sensitive fields BEFORE writing.
//   - Public writes are restricted to /registrations, /checkins, /checkouts
//     and must carry the encrypted ciphertext shape and reference a real event.
//   - /events publicly readable (participant page resolves QR event id).
//   - Reads on registrations/checkins/checkouts/attendance are open in V1 because
//     the dashboard runs on the private operator URL; the data leaked is just
//     ciphertext + masked previews.
//
// V2 hardening: Firebase Auth + custom claim `operator: true` for staff,
// gate reads/deletes/event-writes on that claim.

service cloud.firestore {
  match /databases/{database}/documents {

    function hasEncryptedShape(field) {
      return field is string
        && (field.size() == 0 || field.matches('^enc:v1:.+\\..+'));
    }

    function isValidEventRef(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    function eventIsActive(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.status == 'active';
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /registrations/{registrationId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && eventIsActive(request.resource.data.eventId)
        && hasEncryptedShape(request.resource.data.fullName)
        && hasEncryptedShape(request.resource.data.employeeId)
        && hasEncryptedShape(request.resource.data.email)
        && hasEncryptedShape(request.resource.data.phone)
        && request.resource.data.participation in ['Yes', 'No']
        && request.resource.data.photoConsent is bool
        && request.resource.data.dedupeHash is string;
      allow delete: if true;
    }

    match /checkins/{checkInId} {
      allow read: if true;
      allow create: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && eventIsActive(request.resource.data.eventId)
        && hasEncryptedShape(request.resource.data.uniqueId)
        && hasEncryptedShape(request.resource.data.fullName)
        && request.resource.data.walkInFlag is bool
        && request.resource.data.dedupeHash is string;
      allow update: if false;
      allow delete: if true;
    }

    match /checkouts/{checkOutId} {
      allow read: if true;
      allow create: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && hasEncryptedShape(request.resource.data.uniqueId)
        && hasEncryptedShape(request.resource.data.fullName)
        && request.resource.data.walkInFlag is bool
        && request.resource.data.dedupeHash is string;
      allow update: if false;
      allow delete: if true;
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Admin user directory. Only logged-in admins can read or write.
    // The auth user is the gate; this collection just mirrors Firebase Auth users
    // so the in-app Users page can list them (client SDK can't enumerate auth users).
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
